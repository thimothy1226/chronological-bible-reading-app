{
  "expo": {
    "name": "GF Bible",
    "slug": "gf-bible",
    "version": "1.3.3",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.gfcchurch.gfbible",
      "versionCode": 17,
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F8F1E0"
      }
    },
    "ios": {
      "bundleIdentifier": "com.gfcchurch.gfbible",
      "supportsTablet": true
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "defaultChannel": "group-posts"
        }
      ]
    ],
    "extra": {
      "supportName": "다락방",
      "supportEmail": "thimothy1226@naver.com",
      "privacyPolicyFile": "store/privacy-policy.md",
      "termsFile": "store/terms-of-service.md",
      "buildGuideFile": "BUILD_AND_DEPLOY_GF_BIBLE.md",
      "finalHandoffFile": "FINAL_HANDOFF_GF_BIBLE_v1.3.0.md"
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8F1E0"
    }
  }
}
