    "ios": {
      "bundleIdentifier": "com.biblereading.chronological365",
      "supportsTablet": true
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "defaultChannel": "group-posts"
        }
      ]
    ]
  }
}
