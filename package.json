{
  "name": "gf-bible",
  "version": "1.3.4",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "postinstall": "patch-package",
    "validate": "node scripts/validate-gf-bible.js",
    "build:android:local": "npx expo prebuild --platform android && cd android && ./gradlew assembleRelease --no-daemon",
    "firebase:deploy": "firebase deploy --only functions,firestore:rules",
    "release:info": "node scripts/release-info.js",
    "audit": "node scripts/final-source-audit.js",
    "final:check": "npm run validate && npm run audit && npm run release:info && node --check functions/index.js"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "buffer": "^6.0.3",
    "expo": "~57.0.17",
    "expo-clipboard": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-notifications": "~57.0.16",
    "firebase": "^12.18.0",
    "iconv-lite": "^0.7.2",
    "patch-package": "^8.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-blob-util": "^0.24.10",
    "react-native-pdf": "^7.0.5",
    "string_decoder": "^1.3.0"
  }
}
